@startuml UC-101 Update System Prompts - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam wrapWidth 320
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
title UC-101 Update System Prompts — Class Diagram

class ItStaffPage <<client>> {
  - prompts : EditablePrompt [0..*]
  - saving : String
  - message : String
  + load() : void
  + save(prompt : EditablePrompt) : void
}

class PromptCard <<client>> {
  - prompt : EditablePrompt
  - dirty : boolean
  - saving : boolean
  + onChange(instruction : String) : void
  + onSave() : void
}

class UpdateAiSystemPromptRequest <<dto>> {
  + instruction : String
}

class AiSystemPromptDto <<dto>> {
  + key : String
  + instruction : String
  + updatedAt : Instant
}

class ItStaffController <<controller>> {
  - service : AiSystemPromptService
  + update(key : AiPromptKey, request : UpdateAiSystemPromptRequest) : AiSystemPromptDto
}

class AiSystemPromptService <<service>> {
  - repository : AiSystemPromptRepository
  - currentUserProvider : CurrentUserProvider
  - activityLogService : ActivityLogService
  + update(key : AiPromptKey, instruction : String) : AiSystemPrompt
  + apply(key : AiPromptKey, fixedPrompt : String) : String
}

class ActivityLogService <<service>> {
  - repository : ActivityLogRepository
  + record(actorId, actorRole, category, action, target) : void
}

interface AiSystemPromptRepository {
  + findByKey(key : AiPromptKey) : Optional<AiSystemPrompt>
  + save(prompt : AiSystemPrompt) : AiSystemPrompt
}

class JpaAiSystemPromptRepository <<adapter>> {
  - jpa : AiSystemPromptJpaRepository
}

class AiSystemPrompt <<entity>> {
  - key : AiPromptKey
  - instruction : String
  - updatedBy : UUID
  - updatedAt : Instant
}

class AiSystemPromptEntity <<entity>> {
  - promptKey : String
  - instruction : String
  - updatedBy : UUID
  - updatedAt : Instant
}

enum AiPromptKey {
  LESSON_PLAN_OBJECTIVES
  SLIDE_OUTLINE_STRUCTURE
  SLIDE_DESIGN_CONTENT_FILL
  MOLECULE_STRUCTURE
  PHYSICS_SIMULATION_EDIT
}

ItStaffPage "1" *-- "0..*" PromptCard : renders one card per prompt
ItStaffPage ..> ItStaffController : calls API
ItStaffPage ..> UpdateAiSystemPromptRequest : input
ItStaffController ..> UpdateAiSystemPromptRequest : input
ItStaffController ..> AiSystemPromptDto : output
ItStaffController "1" --> "1" AiSystemPromptService
AiSystemPromptService "1" --> "1" AiSystemPromptRepository
AiSystemPromptService "1" --> "1" ActivityLogService
JpaAiSystemPromptRepository ..|> AiSystemPromptRepository : implements
JpaAiSystemPromptRepository ..> AiSystemPromptEntity : maps
AiSystemPromptEntity "1" -- "1" AiSystemPrompt : mapped to
AiSystemPromptRepository ..> AiSystemPrompt : output
AiSystemPrompt ..> AiPromptKey : identified by

@enduml
