@startuml UC-101 Update System Prompts - Sequence Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
title 2.20.2.3 UC-101 Update System Prompts — Sequence Diagram

actor "IT Staff" as STAFF
participant ":PromptCard" as CARD
participant ":ItStaffPage" as UI
participant ":ItStaffController" as CTL
participant ":AiSystemPromptService" as SVC
participant ":AiSystemPromptRepository" as REPO
participant ":ActivityLogService" as AUDIT
database DB

autonumber
STAFF ->> CARD : Edit the instruction of an open prompt
activate CARD
CARD ->> UI : keep the edited instruction and mark the card as unsaved
activate UI
STAFF ->> CARD : Click "Save" on the prompt card
CARD ->> UI : save(prompt)
deactivate CARD

alt the edited instruction is empty or identical to the stored one
  UI -->> STAFF : Keep the Save action disabled and the stored prompt unchanged (MSG02)
else the instruction was changed and is not empty
  UI ->> CTL : PUT /api/it-staff/system-prompts/{key}
  activate CTL
  CTL ->> SVC : update(key, instruction)
  activate SVC
  SVC ->> SVC : trim the instruction and take the signed-in IT Staff as its author
  SVC ->> REPO : save(AiSystemPrompt with the new instruction)
  activate REPO
  REPO ->> DB : SELECT * FROM ai_system_prompts WHERE prompt_key = ?
  activate DB
  DB -->> REPO : row / none
  deactivate DB
  REPO ->> DB : INSERT INTO ai_system_prompts or UPDATE its instruction, updated_by and updated_at
  activate DB
  DB -->> REPO : Saved
  deactivate DB
  REPO -->> SVC : AiSystemPrompt
  deactivate REPO
  SVC ->> AUDIT : record(actorId, IT_STAFF, CONFIG, UPDATE_SYSTEM_PROMPT, prompt key)
  activate AUDIT
  AUDIT ->> DB : INSERT INTO activity_logs the UPDATE_SYSTEM_PROMPT entry
  activate DB
  DB -->> AUDIT : Saved
  deactivate DB
  AUDIT -->> SVC : Recorded
  deactivate AUDIT
  SVC ->> SVC : the next generation request of that feature reads the stored instruction through apply(key, fixedPrompt)
  SVC -->> CTL : AiSystemPrompt
  deactivate SVC
  CTL -->> UI : HTTP 200 + AiSystemPrompt
  deactivate CTL
  UI -->> STAFF : Show the saved confirmation and the new last-updated time (MSG08)
end
deactivate UI
@enduml
