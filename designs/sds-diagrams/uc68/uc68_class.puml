@startuml UC-68 View Content Comments - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam wrapWidth 320
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
title UC-68 View Content Comments — Class Diagram

class CommunityHubDetailPage <<client>> {
  - detail : HubContentDetail
  - loading : boolean
  - error : String
  - commentsForDisplay : HubComment[]
  + load() : void
}

class HubContentController <<controller>> {
  - contentService : HubContentService
  + get(id : UUID) : HubViews.ContentDetail
}

class HubContentService <<service>> {
  - repository : LibraryContentRepository
  - commentRepository : HubCommentRepository
  - userRepository : AppUserRepository
  - currentUser : CurrentUserProvider
  + get(id : UUID) : HubViews.ContentDetail
}

interface LibraryContentRepository {
  + findApprovedForHubById(id : UUID) : Optional<LibraryContent>
}

interface HubCommentRepository {
  + findByLibraryContentId(libraryContentId : UUID) : List<HubComment>
  + countByLibraryContentId(libraryContentId : UUID) : long
}

interface AppUserRepository {
  + findById(id : UUID) : Optional<AppUser>
}

class JpaHubCommentRepository <<adapter>> {
  - jpa : HubCommentJpaRepository
}

class LibraryContent <<entity>> {
  - id : UUID
  - ownerId : UUID
  - title : String
  - subject : Subject
  - status : LibraryContentStatus
  - payload : JsonNode
  - reviewedAt : Instant
}

class HubComment <<entity>> {
  - id : UUID
  - libraryContentId : UUID
  - authorId : UUID
  - parentCommentId : UUID
  - content : String
  - createdAt : Instant
  - updatedAt : Instant
  - hiddenAt : Instant
}

class HubCommentEntity <<entity>> {
  - id : UUID
  - libraryContentId : UUID
  - parentCommentId : UUID
  - createdAt : Instant
  - hiddenAt : Instant
}

class "HubViews.ContentDetail" as HubContentDetailView <<dto>> {
  + id : UUID
  + title : String
  + ownerName : String
  + payload : JsonNode
  + comments : List<CommentView>
}

class "HubViews.CommentView" as HubCommentView <<dto>> {
  + id : UUID
  + content : String
  + authorId : UUID
  + parentCommentId : UUID
  + authorName : String
  + createdAt : Instant
}

CommunityHubDetailPage ..> HubContentController : calls API
CommunityHubDetailPage ..> HubContentDetailView : output
HubContentController ..> HubContentDetailView : output
HubContentController "1" --> "1" HubContentService
HubContentService "1" --> "1" LibraryContentRepository
HubContentService "1" --> "1" HubCommentRepository
HubContentService "1" --> "1" AppUserRepository
HubContentService ..> HubCommentView : builds
JpaHubCommentRepository ..|> HubCommentRepository : implements
JpaHubCommentRepository ..> HubCommentEntity : maps
HubCommentRepository ..> HubComment : reads visible comments
LibraryContentRepository ..> LibraryContent : reads APPROVED content
LibraryContent "1" -- "0..*" HubComment : has
HubComment "0..*" --> "0..1" HubComment : replies to

@enduml
