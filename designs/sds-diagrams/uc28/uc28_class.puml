@startuml UC-28 Edit Own Blog Comment - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam wrapWidth 320
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
title UC-28 Edit Own Blog Comment — Class Diagram

class BlogCommunityPage <<client>> {
  - detail : Detail
  - editingCommentId : String
  - editCommentText : String
  - editCommentConfirmOpen : boolean
  + startEditComment(comment : Comment) : void
  + requestUpdateComment() : void
  + updateComment() : void
  + loadDetail(id : String) : void
}

class UpdateBlogCommentRequest <<dto>> {
  + content : String
}

class CommentView <<dto>> {
  + id : UUID
  + content : String
  + authorId : UUID
  + authorName : String
  + createdAt : Instant
  + updatedAt : Instant
}

class BlogController <<controller>> {
  - commentService : BlogCommentService
  + updateComment(commentId : UUID, request : UpdateBlogCommentRequest) : CommentView
}

class BlogCommentService <<service>> {
  - commentRepository : BlogCommentRepository
  - sanitizer : BlogContentSanitizer
  - currentUser : CurrentUserProvider
  - COMMENT_MAX_WORDS : int
  + update(commentId : UUID, content : String) : CommentView
}

class BlogContentSanitizer <<service>> {
  + sanitize(html : String) : String
  + isEmpty(sanitizedHtml : String) : boolean
}

interface BlogCommentRepository {
  + findById(id : UUID) : Optional<BlogComment>
  + save(comment : BlogComment) : BlogComment
}

class JpaBlogCommentRepository <<adapter>> {
  - jpa : BlogCommentJpaRepository
}

class BlogComment <<entity>> {
  - id : UUID
  - postId : UUID
  - authorId : UUID
  - parentCommentId : UUID
  - content : String
  - createdAt : Instant
  - updatedAt : Instant
  - hiddenAt : Instant
}

class BlogCommentEntity <<entity>> {
  - id : UUID
  - authorId : UUID
  - content : String
  - updatedAt : Instant
  - hiddenAt : Instant
}

BlogCommunityPage ..> BlogController : calls API
BlogCommunityPage ..> UpdateBlogCommentRequest : input
BlogCommunityPage ..> CommentView : output
BlogController ..> UpdateBlogCommentRequest : input
BlogController ..> CommentView : output
BlogController "1" --> "1" BlogCommentService
BlogCommentService "1" --> "1" BlogCommentRepository
BlogCommentService "1" --> "1" BlogContentSanitizer
JpaBlogCommentRepository ..|> BlogCommentRepository : implements
JpaBlogCommentRepository ..> BlogCommentEntity : maps
BlogCommentRepository ..> BlogComment : uses
BlogCommentEntity "1" -- "1" BlogComment : mapped to

@enduml
