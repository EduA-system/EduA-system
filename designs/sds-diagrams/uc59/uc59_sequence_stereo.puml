@startuml UC-59 View Molecule Structure - Sequence Diagram (stereo)
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280

actor "Chemistry Teacher" as Teacher
participant ":MoleculesPage" as PAGE <<user interaction>>
participant ":MoleculeExplorer" as EXP <<user interaction>>
participant ":MoleculeCatalog" as CAT <<user interaction>>
participant ":MoleculeViewer" as VIEW <<user interaction>>
participant ":MoleculeGeometry" as GEO <<user interaction>>
participant ":Scene" as SCENE <<data abstraction>>

autonumber
Teacher ->> PAGE : Open "Molecular Structure" from the Chemistry Lab
activate PAGE
PAGE ->> EXP : render()
activate EXP
EXP ->> CAT : findMolecules(query, family)
activate CAT
CAT -->> EXP : Molecule[] of the catalog
deactivate CAT
EXP -->> Teacher : Show the molecule list, the default molecule and its formula, molar mass and bond cards

Teacher ->> EXP : Enter a substance name or a chemical formula and pick the Ankan, Anken or Ankin filter
EXP ->> CAT : findMolecules(query, family)
activate CAT
CAT -->> EXP : Molecule[] matching the criteria
deactivate CAT

alt no catalog molecule matches the entered criteria
  EXP -->> Teacher : Show "No matching molecule was found." and keep the current model on screen
else at least one catalog molecule matches
  EXP -->> Teacher : Show the matching molecules with their formulas
  Teacher ->> EXP : Select a molecule from the result list
  EXP ->> EXP : selectMolecule(item)
  EXP ->> VIEW : render()
  activate VIEW
  VIEW ->> SCENE : render()
  activate SCENE
  SCENE ->> GEO : buildGeometry(molecule)
  activate GEO
  GEO ->> GEO : add the implicit hydrogens from the free valence of every heavy atom and centre the molecule on the origin
  GEO -->> SCENE : PositionedMolecule with the atom coordinates and the bonds
  deactivate GEO
  SCENE -->> Teacher : Show the interactive three-dimensional ball-and-stick model
end

opt the teacher inspects the model
  Teacher ->> SCENE : Drag to rotate, scroll to zoom and right-drag to pan
  SCENE -->> Teacher : Update the viewing angle and the scale, with the molecule data unchanged
  Teacher ->> EXP : Switch to "Space Fill" or stop the auto-rotation
  EXP ->> VIEW : render()
  VIEW -->> Teacher : Show the same molecule in the selected render mode
end
deactivate SCENE
deactivate VIEW
deactivate EXP
deactivate PAGE
@enduml
