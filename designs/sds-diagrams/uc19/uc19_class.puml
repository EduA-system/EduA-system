@startuml UC-19 Edit Test - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
title UC-19 Edit Test — Class Diagram

class PracticeExamEditDashboard <<client>> {
  - libraryId : UUID
  - libraryTitle : String
  - savedExam : PracticeExam
  - isDirty : boolean
  + saveDraft(exam : PracticeExam) : void
}

class PracticeExamHtml <<client>> {
  + examHtml(metadata : Metadata, generated : PracticeExam) : String
  + questionContentHtml(question : PracticeExam.Question) : String
  + answersSectionHtml(questions : List<Question>) : String
}

class UpdateLibraryContentRequest <<dto>> {
  + title : String
  + subject : String
  + grade : Integer
  + payload : JsonNode
  + thumbnailUrl : String
}

class LibraryContentController <<controller>> {
  - service : LibraryContentService
  + get(id : UUID) : LibraryViews.Detail
  + update(id : UUID, request : UpdateLibraryContentRequest) : LibraryViews.Detail
}

class LibraryContentService <<service>> {
  - repository : LibraryContentRepository
  - currentUser : CurrentUserProvider
  + get(id : UUID) : LibraryViews.Detail
  + update(id : UUID, title : String, subject : String, payload : JsonNode, thumbnailUrl : String) : LibraryViews.Detail
  - requireOwner(id : UUID) : LibraryContent
}

interface LibraryContentRepository {
  + findActiveById(id : UUID) : Optional<LibraryContent>
  + hasAnySnapshotBySourceId(sourceLibraryContentId : UUID) : boolean
  + save(content : LibraryContent) : LibraryContent
}

class JpaLibraryContentRepository <<adapter>> {
  - jpa : LibraryContentJpaRepository
  - entityManager : EntityManager
}

class LibraryContent <<entity>> {
  - id : UUID
  - ownerId : UUID
  - type : LibraryContentType
  - title : String
  - subject : Subject
  - status : LibraryContentStatus
  - payload : JsonNode
  - updatedAt : Instant
}

enum LibraryContentStatus {
  PRIVATE
  SUBMITTED
  APPROVED
  REJECTED
}

class PracticeExam <<entity>> {
  - title : String
  - instructions : String
  - durationMinutes : int
  - totalScoreCentiPoints : int
  - questions : List<Question>
}

PracticeExamEditDashboard ..> LibraryContentController : calls API
PracticeExamEditDashboard ..> PracticeExamHtml : uses
PracticeExamEditDashboard ..> UpdateLibraryContentRequest : input
PracticeExamHtml ..> PracticeExam : input
LibraryContentController "1" --> "1" LibraryContentService
LibraryContentController ..> UpdateLibraryContentRequest : input
LibraryContentService "1" --> "1" LibraryContentRepository
JpaLibraryContentRepository ..|> LibraryContentRepository : implements
LibraryContentRepository ..> LibraryContent : uses
LibraryContent "1" --> "1" LibraryContentStatus : has
LibraryContent "1" *-- "1" PracticeExam : payload contains

@enduml
