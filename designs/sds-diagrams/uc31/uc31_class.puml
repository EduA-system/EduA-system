@startuml UC-31 View Class List - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam wrapWidth 320
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
title UC-31 View Class List — Class Diagram

class ClassManagementPage <<client>> {
  - items : ClassSummary [0..*]
  - q : String
  - gradeFilter : Integer
  - statusFilter : ClassStatus
  - loading : boolean
  + loadClasses() : void
  + openDetail(id : String) : void
}

class ClassPageDto <<dto>> {
  + items : List<ClassSummaryDto>
  + page : int
  + size : int
  + total : long
}

class ClassSummaryDto <<dto>> {
  + id : UUID
  + name : String
  + subject : Subject
  + grade : Integer
  + memberCount : long
  + status : ClassStatus
  + updatedAt : Instant
}

class ClassController <<controller>> {
  - classManagementService : ClassManagementService
  + list(subject, grade, status, q, page, size) : ClassPageDto
}

class ClassManagementService <<service>> {
  - classRepository : ClassRepository
  - classMemberRepository : ClassMemberRepository
  - currentUserProvider : CurrentUserProvider
  + listOwnedClasses(subject, grade, status, q, page, size) : ClassViews.Page
}

interface ClassRepository {
  + searchOwned(ownerId, subject, grade, status, q, page, size) : SearchResult
}

class JpaClassRepository <<adapter>> {
  - jpa : ClassJpaRepository
}

interface ClassMemberRepository {
  + countByClassId(classId : UUID) : long
}

class Classroom <<entity>> {
  - id : UUID
  - ownerId : UUID
  - name : String
  - subject : Subject
  - grade : Integer
  - status : ClassStatus
  - updatedAt : Instant
  + isOwnedBy(userId : UUID) : boolean
}

class ClassEntity <<entity>> {
  - id : UUID
  - ownerId : UUID
  - name : String
  - subject : Subject
  - grade : Integer
  - status : ClassStatus
  - updatedAt : Instant
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

ClassManagementPage ..> ClassController : calls API
ClassController ..> ClassPageDto : output
ClassController "1" --> "1" ClassManagementService
ClassManagementService "1" --> "1" ClassRepository
ClassManagementService "1" --> "1" ClassMemberRepository
JpaClassRepository ..|> ClassRepository : implements
JpaClassRepository ..> ClassEntity : maps
ClassEntity "1" -- "1" Classroom : mapped to
ClassRepository ..> Classroom : output
ClassPageDto "1" *-- "0..*" ClassSummaryDto : contains
Classroom ..> ClassStatus : lifecycle status

@enduml
