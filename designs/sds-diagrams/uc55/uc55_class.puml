@startuml UC-55 Save Molecule Model to Personal Library - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam wrapWidth 320
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
title UC-55 Save Molecule Model to Personal Library — Class Diagram

class MoleculeExplorer <<client>> {
  - molecule : Molecule
  - mode : RenderMode
  - rotating : boolean
  - saving : boolean
  - savedFingerprint : String
  - message : String
  + save() : void
  + render() : ReactNode
}

class Molecule <<dto>> {
  + name : String
  + formula : String
  + atoms : MoleculeAtom [0..*]
  + bonds : MoleculeBond [0..*]
}

class MoleculeAtom <<dto>> {
  + element : ElementSymbol
  + position : number [3]
}

class MoleculeBond <<dto>> {
  + from : number
  + to : number
  + order : number
}

class CreateLibraryContentRequest <<dto>> {
  + type : String
  + title : String
  + subject : String
  + payload : JsonNode
  + thumbnailUrl : String
}

class "LibraryViews.Detail" as LibraryDetailView <<dto>> {
  + id : UUID
  + type : LibraryContentType
  + title : String
  + subject : Subject
  + status : LibraryContentStatus
  + payload : JsonNode
}

class LibraryContentController <<controller>> {
  - service : LibraryContentService
  + create(r : CreateLibraryContentRequest) : LibraryViews.Detail
}

class LibraryContentService <<service>> {
  - repository : LibraryContentRepository
  - currentUser : CurrentUserProvider
  + create(type, title, subject, grade, textbookCode, chapterCode, payload, thumbnailUrl) : LibraryViews.Detail
}

interface LibraryContentRepository {
  + save(content : LibraryContent) : LibraryContent
  + findActiveByOwnerTypeSubjectAndPayload(ownerId, type, subject, payloadJson) : Optional<LibraryContent>
}

class JpaLibraryContentRepository <<adapter>> {
  - jpa : LibraryContentJpaRepository
}

class LibraryContent <<entity>> {
  - id : UUID
  - ownerId : UUID
  - type : LibraryContentType
  - title : String
  - subject : Subject
  - status : LibraryContentStatus
  - payload : JsonNode
  - createdAt : Instant
  - updatedAt : Instant
  - deletedAt : Instant
}

enum LibraryContentStatus {
  PRIVATE
  SUBMITTED
  APPROVED
  REJECTED
}

MoleculeExplorer "1" --> "1" Molecule : model on screen
Molecule "1" *-- "1..*" MoleculeAtom : contains
Molecule "1" *-- "0..*" MoleculeBond : contains
MoleculeExplorer ..> LibraryContentController : calls API
MoleculeExplorer ..> CreateLibraryContentRequest : input
LibraryContentController ..> CreateLibraryContentRequest : input
LibraryContentController ..> LibraryDetailView : output
LibraryContentController "1" --> "1" LibraryContentService
LibraryContentService "1" --> "1" LibraryContentRepository
JpaLibraryContentRepository ..|> LibraryContentRepository : implements
LibraryContentRepository ..> LibraryContent : uses
LibraryContent ..> LibraryContentStatus : saved as PRIVATE draft

@enduml
