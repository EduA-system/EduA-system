@startuml UC-102 View Staff List - Sequence Diagram (icon)
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
title 2.19.2.1 UC-102 View Staff List — Sequence Diagram

actor Principal
boundary ":UserManagementPage" as UI
control ":PrincipalController" as CTL
control ":PrincipalModeratorService" as MODSVC
control ":PrincipalItStaffService" as ITSVC
boundary ":AppUserRepository" as USERS
boundary ":UserRoleRepository" as ROLES
database DB

autonumber
Principal ->> UI : Open the Staff Management screen
activate UI
UI ->> UI : loadModerators(page)
UI ->> CTL : GET /api/principal/moderators?page=&size=
activate CTL
CTL ->> MODSVC : listModerators(page, size)
activate MODSVC
MODSVC ->> USERS : findAllByRole(MODERATOR, page, size)
activate USERS
USERS ->> DB : SELECT * FROM app_users JOIN user_roles ON the MODERATOR role ORDER BY created_at DESC LIMIT ? OFFSET ?
activate DB
DB -->> USERS : rows
deactivate DB
USERS -->> MODSVC : AppUserPage
deactivate USERS
MODSVC ->> ROLES : findGrantedAtsByUserIds(userIds, MODERATOR)
activate ROLES
ROLES ->> DB : SELECT user_id, granted_by, granted_at FROM user_roles WHERE user_id IN (?) AND the MODERATOR role
activate DB
DB -->> ROLES : rows
deactivate DB
ROLES -->> MODSVC : Map<String, Date>
deactivate ROLES
MODSVC -->> CTL : ModeratorListResult
deactivate MODSVC
CTL -->> UI : HTTP 200 + ModeratorDtoPage
deactivate CTL

UI ->> UI : loadItStaff(page)
UI ->> CTL : GET /api/principal/it-staff?page=&size=
activate CTL
CTL ->> ITSVC : list(page, size)
activate ITSVC
ITSVC ->> USERS : findAllByRole(IT_STAFF, page, size)
activate USERS
USERS ->> DB : SELECT * FROM app_users JOIN user_roles ON the IT_STAFF role ORDER BY created_at DESC LIMIT ? OFFSET ?
activate DB
DB -->> USERS : rows
deactivate DB
USERS -->> ITSVC : AppUserPage
deactivate USERS
ITSVC -->> CTL : AppUserPage
deactivate ITSVC
CTL -->> UI : HTTP 200 + ItStaffDtoPage
deactivate CTL

alt no staff position is assigned yet
  UI -->> Principal : Show MSG01 and the forms that assign the positions
else at least one position is assigned
  UI -->> Principal : Show every Moderator with subject, granting account and status, the IT Supporter position, and the Replace and Reactivate actions
end
deactivate UI
@enduml
