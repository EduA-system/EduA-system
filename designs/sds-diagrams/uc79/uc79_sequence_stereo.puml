@startuml UC-79 Add Teacher - Sequence Diagram (stereo)
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280

actor Moderator
participant ":UserManagementContent" as UI <<user interaction>>
participant ":ModeratorController" as CTL <<coordinator>>
participant ":ModeratorTeacherService" as SVC <<business logic>>
participant ":AppUserRepository" as USERS <<interface>>
participant ":UserRoleRepository" as ROLES <<interface>>
participant ":TeacherGradeRepository" as GRADES <<interface>>
database DB

autonumber
activate Moderator
Moderator ->> UI : Enter the teacher Gmail address, full name and applicable grades, with the subject fixed to the moderator subject, then select "Add"
activate UI
UI ->> UI : addTeacher()
UI ->> UI : block the call while a required field is empty or the email format is invalid (MSG02, MSG03)
UI ->> CTL : POST /api/moderator/teachers
activate CTL
CTL ->> SVC : addTeacher(email, subject, fullName, grades)
activate SVC
SVC ->> SVC : accept only the moderator's own subject and grades among 10, 11 and 12 (BR-18)
SVC ->> USERS : findByEmail(email)
activate USERS
USERS ->> DB : SELECT * FROM app_users WHERE email = ?
activate DB
DB -->> USERS : row / none
deactivate DB
USERS -->> SVC : AppUser
deactivate USERS

alt the email already belongs to an active account, to another role or to another subject
  SVC -->> CTL : DuplicateEmailException / ForbiddenOperationException
  CTL -->> UI : HTTP 409 / 403
  UI -->> Moderator : Show the message that the account cannot be added and keep the entered values
else the email is new or belongs to a revoked teacher of the same subject
  SVC ->> USERS : save(AppUser with status INVITED)
  activate USERS
  USERS ->> DB : INSERT INTO app_users email, full_name, subject, status = 'INVITED'
  activate DB
  DB -->> USERS : Saved
  deactivate DB
  USERS -->> SVC : AppUser
  deactivate USERS
  SVC ->> ROLES : replaceRole(userId, TEACHER, grantedBy, grantedAt)
  activate ROLES
  ROLES ->> DB : INSERT INTO user_roles user_id, role, granted_by, granted_at
  deactivate ROLES
  SVC ->> GRADES : replaceGrades(userId, grades)
  activate GRADES
  GRADES ->> DB : DELETE the removed rows and INSERT the selected grades in teacher_grades
  deactivate GRADES
  SVC ->> SVC : record the GRANT_TEACHER entry of the account-management activity log
  SVC -->> CTL : AppUser
  CTL -->> UI : HTTP 201 + Teacher
  UI -->> Moderator : Show MSG08 and the refreshed teacher list with the new account in status Invited
end
deactivate SVC
deactivate CTL
deactivate UI
deactivate Moderator
@enduml
