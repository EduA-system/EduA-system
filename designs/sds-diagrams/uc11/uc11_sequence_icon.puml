@startuml UC-11 Delete Content - Sequence Diagram (icon)
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
title 2.9.2.4 UC-11 Delete Content — Sequence Diagram

actor Teacher
boundary ":LibraryScreen" as UI
control ":LibraryContentController" as CTL
control ":LibraryContentService" as SVC
boundary ":LibraryContentRepository" as REPO
database DB

autonumber
Teacher ->> UI : Open the item menu and choose "Delete"
activate UI
UI ->> UI : requestAction(content, kind)
UI -->> Teacher : Show the confirmation dialog with the item title (MSG09)

opt teacher cancels the deletion
  Teacher ->> UI : Click "Cancel"
  UI -->> Teacher : Close the dialog, change nothing stored, and end the use case
end

Teacher ->> UI : Click "Delete" to confirm
UI ->> UI : performAction()
UI ->> CTL : DELETE /api/library/contents/{id}
activate CTL
CTL ->> SVC : delete(id)
activate SVC
SVC ->> REPO : findActiveById(id)
activate REPO
REPO ->> DB : SELECT * FROM library_contents WHERE id = ?
activate DB
DB -->> REPO : row / none
deactivate DB
REPO -->> SVC : LibraryContent
deactivate REPO
SVC ->> SVC : check that the item exists, is not already deleted and belongs to the teacher

alt the item is unavailable or not owned by the teacher
  SVC -->> CTL : ResourceNotFoundException / ForbiddenOperationException
  CTL -->> UI : HTTP 404 / 403
  UI -->> Teacher : Show that the content is unavailable or not permitted, keep the list unchanged (MSG25)
else the teacher owns the item
  SVC ->> REPO : save(LibraryContent with deletedAt set to now)
  activate REPO
  REPO ->> DB : UPDATE library_contents SET deleted_at = ?, updated_at = ? WHERE id = ?
  activate DB
  DB -->> REPO : Saved
  deactivate DB
  REPO -->> SVC : LibraryContent
  deactivate REPO
  SVC -->> CTL : void
  CTL -->> UI : HTTP 204 No Content
  UI ->> UI : load()
  UI -->> Teacher : Show MSG10 and refresh the Personal Library without the deleted item
end
deactivate SVC
deactivate CTL
deactivate UI
@enduml
