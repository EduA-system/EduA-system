@startuml UC-10 Update Content - Sequence Diagram (stereo)
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260

actor Teacher
participant ":LessonEditDashboard" as EDT <<user interaction>>
participant ":LibraryContentController" as CTL <<coordinator>>
participant ":LibraryContentService" as SVC <<business logic>>
participant ":LibraryContentRepository" as REPO <<interface>>
database DB

autonumber
activate Teacher
Teacher ->> EDT : Modify the opened content and click "Save"
activate EDT
EDT ->> EDT : saveLesson(allowDuringGeneration)
EDT ->> EDT : build the payload and derive the title, subject, grade and thumbnail
EDT ->> CTL : PATCH /api/library/contents/{id}
activate CTL
CTL ->> SVC : update(id, title, subject, grade, textbookCode, chapterCode, payload, thumbnailUrl)
activate SVC
SVC ->> REPO : findActiveById(id)
activate REPO
REPO ->> DB : SELECT * FROM library_contents WHERE id = ?
activate DB
DB -->> REPO : row / none
deactivate DB
REPO -->> SVC : LibraryContent
deactivate REPO
SVC ->> SVC : check ownership and keep every field the request does not provide

alt the title is blank or the subject is cleared while the item is pending review
  SVC -->> CTL : IllegalArgumentException
  CTL -->> EDT : HTTP 400 with the field error
  EDT -->> Teacher : Highlight the invalid field, keep the edits in the editor and change nothing stored
else the update is valid
  SVC ->> REPO : hasAnySnapshotBySourceId(id)
  activate REPO
  REPO ->> DB : SELECT 1 FROM library_contents WHERE source_library_content_id = ?
  activate DB
  DB -->> REPO : true / false
  deactivate DB
  REPO -->> SVC : boolean
  deactivate REPO
  SVC ->> SVC : reset the status to PRIVATE when a published Hub snapshot exists, keep it otherwise
  SVC ->> REPO : save(updated LibraryContent)
  activate REPO
  REPO ->> DB : UPDATE library_contents SET metadata, payload, updated_at, version = version + 1\nWHERE id = ? AND version = ?
  activate DB
  DB -->> REPO : Saved
  deactivate DB
  REPO -->> SVC : LibraryContent
  deactivate REPO
  SVC -->> CTL : LibraryDetail
  CTL -->> EDT : HTTP 200 + LibraryDetail
  EDT -->> Teacher : Show the success message and the new Publish Status (MSG08)
end
deactivate SVC
deactivate CTL
deactivate EDT
deactivate Teacher
@enduml
