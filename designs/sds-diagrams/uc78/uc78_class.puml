@startuml UC-78 View Teacher Detail - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam wrapWidth 320
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
title UC-78 View Teacher Detail — Class Diagram

class UserManagementContent <<client>> {
  - teacherData : PageResponse<SubjectAccountItem>
  - teacherEditTarget : SubjectAccountItem
  - msg : String
  + loadTeachers(page : number) : void
  + openTeacherEdit(item : SubjectAccountItem) : void
}

class TeacherDto <<dto>> {
  + id : UUID
  + email : String
  + fullName : String
  + phoneNumber : String
  + dateOfBirth : LocalDate
  + subject : String
  + grades : List<Integer>
  + status : String
  + grantedAt : Instant
  + grantedByEmail : String
}

class ModeratorController <<controller>> {
  - moderatorTeacherService : ModeratorTeacherService
  + listTeachers(page : int, size : int) : Page<TeacherDto>
}

class ModeratorTeacherService <<service>> {
  - userRepository : AppUserRepository
  - userRoleRepository : UserRoleRepository
  - teacherGradeRepository : TeacherGradeRepository
  + listTeachers(pageable : Pageable) : TeacherListResult
}

interface AppUserRepository {
  + findAllByRoleAndSubject(role, subject, pageable) : Page<AppUser>
  + findAllById(ids : Collection<UUID>) : List<AppUser>
}

interface UserRoleRepository {
  + findGrantedByUserIdsByUserIds(userIds, role) : Map<UUID, UUID>
  + findGrantedAtsByUserIds(userIds, role) : Map<UUID, Instant>
}

interface TeacherGradeRepository {
  + findGradesByUserIds(userIds : Collection<UUID>) : Map<UUID, List<Integer>>
}

class JpaAppUserRepository <<adapter>> {
  - jpa : AppUserJpaRepository
}

class AppUserEntity <<entity>> {
  - id : UUID
  - email : String
  - fullName : String
  - phoneNumber : String
  - dateOfBirth : LocalDate
  - subject : Subject
  - status : UserStatus
}

class AppUser <<entity>> {
  - id : UUID
  - email : String
  - fullName : String
  - phoneNumber : String
  - dateOfBirth : LocalDate
  - subject : Subject
  - status : UserStatus
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

UserManagementContent ..> ModeratorController : calls API
UserManagementContent ..> TeacherDto : uses
ModeratorController ..> TeacherDto : output
ModeratorController "1" --> "1" ModeratorTeacherService
ModeratorTeacherService "1" --> "1" AppUserRepository
ModeratorTeacherService "1" --> "1" UserRoleRepository
ModeratorTeacherService "1" --> "1" TeacherGradeRepository
JpaAppUserRepository ..|> AppUserRepository : implements
JpaAppUserRepository ..> AppUserEntity : maps
AppUserEntity "1" -- "1" AppUser : mapped to
AppUserRepository ..> AppUser : output
AppUser ..> UserStatus : has

@enduml
