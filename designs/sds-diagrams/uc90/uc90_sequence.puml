@startuml UC-90 View Lesson Plan Detail - Sequence Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280
title 2.15.2.8 UC-90 View Lesson Plan Detail — Sequence Diagram

actor Moderator
participant ":LessonPlanApprovalScreen" as UI
participant ":WeeklyTaskController" as CTL
participant ":WeeklyTaskService" as SVC
participant ":WeeklyTaskRepository" as REPO
database DB
participant "File Storage Service" as FS

autonumber
Moderator ->> UI : Click "View detail" on a submission of the approval list
activate UI
UI ->> UI : handleExpand(id)
UI ->> CTL : GET /api/weekly-tasks/{id}
activate CTL
CTL ->> SVC : get(id)
activate SVC
SVC ->> REPO : findById(id)
activate REPO
REPO ->> DB : SELECT * FROM weekly_tasks WHERE id = ?
activate DB
DB -->> REPO : row / none
deactivate DB
REPO -->> SVC : WeeklyTask
deactivate REPO
SVC ->> SVC : accept only a submission of the moderator assigned subject (BR-18) or a task assigned to the signed-in teacher

alt the submission does not exist, was withdrawn or lies outside the assigned subject
  SVC -->> CTL : ResourceNotFoundException / ForbiddenOperationException
  CTL -->> UI : HTTP 404 / 403
  UI -->> Moderator : Report that the submission is unavailable (MSG25) and collapse the card
else the submission belongs to the assigned subject
  SVC -->> CTL : WeeklyTaskDetail
  CTL -->> UI : HTTP 200 + WeeklyTaskDetail
  UI -->> Moderator : Show teacher, weekly task requirement, deadline, submitted time, the submitted lesson-plan source and the Approve and Reject actions
end
deactivate SVC
deactivate CTL

Moderator ->> UI : Click "Open resource" for a lesson plan submitted from the personal library
UI ->> UI : openSubmittedLessonPreview(taskDetail)
UI -->> Moderator : Show the submitted lesson plan in the preview dialog

opt the submission carries an uploaded lesson-plan document
  Moderator ->> UI : Click "View uploaded document"
  UI ->> FS : Open the stored document URL of the submission
  activate FS
  FS -->> UI : Uploaded lesson-plan document
  deactivate FS
  UI -->> Moderator : Show the uploaded lesson-plan document in a new browser tab
end
deactivate UI
@enduml
