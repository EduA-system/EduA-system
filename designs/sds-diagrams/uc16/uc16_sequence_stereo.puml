@startuml UC-16 Present Slide - Sequence Diagram (stereo)
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ArrowColor #000000
skinparam sequenceMessageAlign left
skinparam maxMessageSize 280

actor Teacher
participant ":TopBar" as TB <<user interaction>>
participant ":SlideMakerClient" as SMC <<user interaction>>
participant ":SlideEditorStore" as STORE <<user interaction>>
participant ":SlidePresentationOverlay" as OVL <<user interaction>>
participant ":ElementView" as EV <<user interaction>>

autonumber
activate Teacher
Teacher ->> TB : Click "Present" for the slide deck
activate TB
TB ->> SMC : openPresentation()
activate SMC
SMC ->> STORE : read the slide deck currently open in the editor
activate STORE
STORE -->> SMC : Slide [0..*] with their elements
deactivate STORE
SMC ->> SMC : keep the deck in the browser storage before the presentation starts
SMC ->> OVL : open the presentation overlay with the loaded deck
activate OVL
OVL ->> OVL : request full-screen mode for the presentation stage

alt the browser denies full-screen mode
  OVL ->> Teacher : Show the deck in a maximized presentation view and retry full-screen on the next interaction
else full-screen mode is granted
  OVL ->> Teacher : Show the first slide scaled to the screen
end

OVL ->> EV : draw every element of the current slide
activate EV
EV -->> Teacher : Show the slide text, images, placeholders for unavailable assets and embedded simulations
Teacher ->> OVL : Press ArrowRight, Space or PageDown to move forward
OVL ->> OVL : next()
Teacher ->> OVL : Press ArrowLeft or PageUp to move back
OVL ->> OVL : previous()
Teacher ->> EV : Click an element of an embedded periodic-table simulation
EV ->> OVL : setSelectedElement(element)
deactivate EV
OVL ->> Teacher : Open the element detail panel over the current slide
Teacher ->> OVL : Press Esc to end the presentation
OVL ->> SMC : closePresentation()
deactivate OVL
SMC ->> Teacher : Return to the Slide Deck Editor with the stored deck unchanged
deactivate SMC
deactivate TB
deactivate Teacher
@enduml
