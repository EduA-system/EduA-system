@startuml feat04 Slide Editing and Presentation - Class Diagram
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam wrapWidth 320
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #000000
skinparam ArrowColor #000000
skinparam classAttributeIconSize 0
hide circle
title 2.4.1 Slide Editing and Presentation — Class Diagram
class SlideEditor <<user interaction>> {
  - skipInitialLoad : Boolean
  - savingToLibrary : Boolean
  + onSaveToLibrary()
}

class SlideEditorStore <<user interaction>> {
  - slides : Slide [0..*]
  - currentSlideId : String
  - selectedIds : String [0..*]
  + updateElement(id : String, patch : ElementPatch)
  + reorderSlides(from : Integer, to : Integer)
}

class SlideMakerClient <<user interaction>> {
  - steps : StepStates
  - libraryId : String
  - saving : Boolean
  + openSaveDialog()
  + openPresentation()
  + closePresentation()
}

class LibraryContentController <<coordinator>> {
  - service : LibraryContentService
  + list(type, subject, grade, textbookCode, chapterCode, q, status, page, size, sort) : Page
  + get(id : String) : Detail
  + update(id : String, request : UpdateLibraryContentRequest) : Detail
  + delete(id : String)
  + create(r : CreateLibraryContentRequest) : Detail
}

class LibraryContentService <<business logic>> {
  - repository : LibraryContentRepository
  + update(id : String, title, subject, grade, textbookCode, chapterCode, payload, thumbnailUrl) : Detail
}

class LibraryContentRepository <<interface>> {
  {field}
  --
  + findActiveById(id : String) : LibraryContent
  + save(content : LibraryContent) : LibraryContent
}

class TopBar <<user interaction>> {
  - hasLockedSlides : Boolean
  - menu : String
  - exportingHtml : Boolean
  + exportHtml()
}

class SlidePresentationOverlay <<user interaction>> {
  - activeIndex : Integer
  - scale : Real
  - selectedElement : PeriodicElement
  + next()
  + previous()
  + setSelectedElement(element : PeriodicElement)
}

class ElementView <<user interaction>> {
  - el : SlideElement
  - interactive : Boolean
  + onSelectPeriodicElement(element : PeriodicElement)
}

class SlideHtmlExport <<user interaction>> {
  - PLACEHOLDER_IMAGE : String
  - CONTENT_TYPE_EXT : Map
  + exportOfflineZip(slides : Slide[], title : String) : OfflineZipExport
  + buildOfflineHtml(slides, title, imageSources, simulationSources) : String
  + downloadOfflineZip(blob : Blob, title : String)
}

class JSZip <<user interaction>> {
  + file(path : String, data : Blob) : JSZip
  + folder(name : String) : JSZip
  + generateAsync(options : ZipOptions) : Blob
}

class JpaLibraryContentRepository <<database wrapper>> {
  - jpa : LibraryContentJpaRepository
  - entityManager : EntityManager
}

class LibraryContent <<entity>> {
  - id : String
  - ownerId : String
  - type : LibraryContentType
  - title : String
  - status : LibraryContentStatus
}

LibraryContentController "1" -- "1" LibraryContentService : Delegates to >
LibraryContentService "1" -- "1" LibraryContentRepository : Accesses data through >
SlideEditor "1" -- "1" LibraryContentController : Sends requests to >
SlideEditorStore "1" -- "1" LibraryContentController : Sends requests to >
SlideMakerClient "1" -- "1" LibraryContentController : Sends requests to >
TopBar "1" -- "1" LibraryContentController : Sends requests to >
SlidePresentationOverlay "1" -- "1" LibraryContentController : Sends requests to >
ElementView "1" -- "1" LibraryContentController : Sends requests to >
SlideHtmlExport "1" -- "1" LibraryContentController : Sends requests to >
JSZip "1" -- "1" LibraryContentController : Sends requests to >
JpaLibraryContentRepository ..|> LibraryContentRepository
JpaLibraryContentRepository "1" -- "0..*" LibraryContent : Maps >

@enduml
