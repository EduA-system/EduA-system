        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="fan" value="soạn chi tiết TỪNG hoạt động (song song tối đa 4)">
          <mxGeometry relative="1" as="geometry" />
