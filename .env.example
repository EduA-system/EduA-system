# ---- PostgreSQL (Docker) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=himawari
POSTGRES_DB=edua_system
POSTGRES_PORT=9118

# ---- Managed PostgreSQL (cloud, e.g. Aiven) ----
# Spring Boot reads these directly. Leave blank to use local Docker above.
DB_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ---- AI providers ----
# OpenAI — vision-capable primary
APP_AI_OPENAI_API_KEY=
# (tùy chọn, có default trong application.properties)
# APP_AI_OPENAI_BASE_URL=https://api.openai.com
# APP_AI_OPENAI_DEFAULT_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-compatible) — text-only fallback
APP_AI_DEEPSEEK_API_KEY=
# APP_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# APP_AI_DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# ---- Cloudflare R2 (S3-compatible) ----
APP_R2_ENDPOINT=
APP_R2_ACCESS_KEY_ID=
APP_R2_SECRET_ACCESS_KEY=
APP_R2_BUCKET=edua
APP_R2_PUBLIC_URL=
